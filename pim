def _arg_value(args: list[str], name: str) -> str | None:
    if name not in args:
        return None
    idx = args.index(name)
    if idx + 1 >= len(args) or not args[idx + 1].strip():
        print(f"Usage: ./pim upgrade {name} <value>", file=sys.stderr)
        sys.exit(2)
    return args[idx + 1].strip()


def _pid_file_candidates() -> list[Path]:
    out: list[Path] = []
    for path in (PID_FILE, LEGACY_PID_FILE):
        if path not in out:
            out.append(path)
    return out


def _read_pid_file(path: Path) -> int:
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return 0


def _write_pid_file(pid: int) -> None:
    PID_FILE.parent.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(pid))
    if LEGACY_PID_FILE != PID_FILE and LEGACY_PID_FILE.exists():
        LEGACY_PID_FILE.unlink(missing_ok=True)


def _unlink_pid_files() -> None:
    for path in _pid_file_candidates():
        path.unlink(missing_ok=True)


def _ensure_git_ready(*, no_pull: bool) -> None:
    if not (ROOT / ".git").exists():
        print("Not a git checkout; cannot pull updates. Use ./pim setup instead.", file=sys.stderr)
        sys.exit(1)

    status = subprocess.check_output(
        ["git", "status", "--porcelain"],
        cwd=str(ROOT),
        text=True,
    ).strip()
    if status:
        print("Working tree has local changes; refusing to upgrade.", file=sys.stderr)
        print("Commit/stash them first, then rerun ./pim upgrade.", file=sys.stderr)
        sys.exit(1)

    try:
        branch = subprocess.check_output(
            ["git", "symbolic-ref", "--short", "-q", "HEAD"],
            cwd=str(ROOT),
            text=True,
        ).strip()
    except subprocess.CalledProcessError:
        # ``git symbolic-ref`` exits 1 for a detached HEAD. Treat that as an
        # expected empty branch so the explicit detached-checkout policy below
        # can decide whether --no-pull makes the upgrade safe to continue.
        branch = ""
    if not branch and not no_pull:
        print("Current checkout is detached (likely a tag). Checkout main before upgrading.", file=sys.stderr)
        print("Example: git checkout main && git pull --ff-only", file=sys.stderr)
        print("For tag/detached deployments that already have the desired code, use: ./pim upgrade --no-pull", file=sys.stderr)
        sys.exit(1)
    if not branch and no_pull:
        print("Detached checkout detected; continuing because --no-pull was supplied.")


def _upgrade_dependencies_and_assets(*, server_only: bool, rebuild: bool) -> None:
    _ensure_venv()
    _install_deps()
    _install_playwright()
    _ensure_env_file()
    if server_only:
        print("  Skipping frontend build (--server).")
    else:
        _ensure_frontend_built(rebuild=rebuild)


def _restart_systemd_unit(unit: str) -> bool:
    if not shutil.which("systemctl") or not Path("/run/systemd/system").exists():
        print(
            f"systemd is not available in this environment; skipped restart for unit: {unit}",
            file=sys.stderr,
        )
        return False
    if os.geteuid() == 0:
        cmd = ["systemctl", "restart", unit]
    else:
        sudo = shutil.which("sudo")
        if not sudo:
            print(
                f"sudo is not available; skipped systemd restart for unit: {unit}",
                file=sys.stderr,
            )
            return False
        cmd = [sudo, "systemctl", "restart", unit]
    subprocess.check_call(cmd)
    print(f"Restarted systemd unit: {unit}")
    return True


def cmd_upgrade():
    """Upgrade an existing checkout with backup-first, fast-forward-only semantics."""
    args = sys.argv[2:]
    server_only = "--server" in args or "--no-frontend" in args
    rebuild = "--rebuild" in args
    no_pull = "--no-pull" in args
    no_backup = "--no-backup" in args
    no_restart = "--no-restart" in args
    systemd_unit = _arg_value(args, "--systemd")
    restart_mode = _arg_value(args, "--restart-mode") or "auto"
    if restart_mode not in {"auto", "stop-start", "ensure"}:
        print("Usage: ./pim upgrade [--restart-mode auto|stop-start|ensure]", file=sys.stderr)
        sys.exit(2)

    print("=== PIM Upgrade ===")
    _ensure_git_ready(no_pull=no_pull)

    was_running = _currently_running_pid() is not None or _is_port_8000_open()
    was_launchd = _is_launchd_backed()

    runtime = _read_runtime_metadata() if VENV.exists() else {}
    db_path = _sqlite_path_from_url(str(runtime.get("database_url") or ""))
    if not no_backup and db_path and db_path.exists():
        print("\n[1/4] Backup")
        cmd_backup()
    elif no_backup:
        print("\n[1/4] Backup skipped (--no-backup).")
    else:
        print("\n[1/4] Backup skipped (SQLite database not found yet).")

    if no_pull:
        print("\n[2/4] Git pull skipped (--no-pull).")
    else:
        print("\n[2/4] Pull latest code")
        subprocess.check_call(["git", "pull", "--ff-only"], cwd=str(ROOT))

    print("\n[3/4] Refresh dependencies and frontend assets")
    _upgrade_dependencies_and_assets(server_only=server_only, rebuild=rebuild)

    print("\n[4/4] Restart")
    if no_restart:
        print("Restart skipped (--no-restart).")
    elif restart_mode == "ensure":
        _run_with_args(cmd_ensure, args)
    elif systemd_unit:
        _restart_systemd_unit(systemd_unit)
    elif was_launchd:
        cmd_install_service()
    elif was_running:
        cmd_stop()
        cmd_up()
    else:
        print("Service was not running before upgrade; leaving it stopped.")

    print("\nRefresh complete. Code was not updated (--no-pull)." if no_pull else "\nUpgrade complete.")


def _read_api_key():
    """Read the active API key from runtime secrets/bootstrap state."""
    return _bootstrap_runtime_api_key()


def _is_pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _read_pid_command(pid: int) -> str:
    try:
        out = subprocess.check_output(["ps", "-p", str(pid), "-o", "command="], text=True)
        return out.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def _is_prod_uvicorn_pid(pid: int, port: int | None = None) -> bool:
    if not _is_pid_alive(pid):
        return False
    cmd = _read_pid_command(pid)
    if not cmd:
        return False
    target_port = port or _get_pim_port()
    return "uvicorn" in cmd and "app.main:app" in cmd and f"--port {target_port}" in cmd


def _is_port_open(port: int | None = None) -> bool:
    target_port = port or _get_pim_port()
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(0.3)
    try:
        return sock.connect_ex(("127.0.0.1", target_port)) == 0
    finally:
        sock.close()


def _is_port_8000_open() -> bool:
    return _is_port_open(_get_pim_port())


def _terminate_pid(pid: int, timeout_seconds: float = 4.0) -> bool:
    """Gracefully terminate pid, escalate to SIGKILL on timeout."""
    if not _is_pid_alive(pid):
        return True
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False

    started = time.time()
    while time.time() - started < timeout_seconds:
        if not _is_pid_alive(pid):
            return True
        time.sleep(0.1)

    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False
    time.sleep(0.1)
    return not _is_pid_alive(pid)


def _find_prod_uvicorn_pids(port: int | None = None) -> list[int]:
    target_port = port or _get_pim_port()
    pattern = f"app.main:app.*--port {target_port}"
    try:
        out = subprocess.check_output(["pgrep", "-f", pattern], text=True).strip()
    except (OSError, subprocess.SubprocessError):
        return []
    pids: list[int] = []
    for raw in out.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        try:
            pid = int(raw)
            if _is_prod_uvicorn_pid(pid, port=target_port):
                pids.append(pid)
        except ValueError:
            continue
    return pids


def _ensure_runtime_ready() -> str | None:
    """Guarantee venv/deps/.env exist; return the active API key when available."""
    if not VENV.exists():
        _ensure_venv()
        _install_deps()
    _ensure_env_file()
    return _bootstrap_runtime_api_key()


def _is_launchd_backed() -> bool:
    """True when the macOS LaunchAgent plist has been installed."""
    return sys.platform == "darwin" and PLIST_PATH.exists()


def _currently_running_pid() -> int | None:
    """Best-effort discovery of the currently-running prod uvicorn PID.

    Covers three discovery paths: launchd (authoritative on macOS), our own
    pid file, and a process-table scan. Returns None when we can't confidently
    identify a live prod server.
    """
    if _is_launchd_backed():
        try:
            out = subprocess.check_output(
                ["launchctl", "list", PLIST_NAME],
                text=True, stderr=subprocess.DEVNULL,
            )
        except subprocess.CalledProcessError:
            out = ""
        for line in out.splitlines():
            line = line.strip()
            if line.startswith('"PID"'):
                raw = line.split("=", 1)[-1].strip().rstrip(";").strip()
                if raw.isdigit():
                    return int(raw)

    for pid_file in _pid_file_candidates():
        if pid_file.exists():
            pid = _read_pid_file(pid_file)
            if pid and _is_prod_uvicorn_pid(pid):
                if pid_file != PID_FILE:
                    _write_pid_file(pid)
                return pid

    for pid in _find_prod_uvicorn_pids():
        if _is_prod_uvicorn_pid(pid):
            _write_pid_file(pid)
            return pid

    return None


def cmd_up():
    """One-shot bring-up: deps + fresh frontend + daemonized backend.

    Intended to cover both fresh installs and "nothing is running right now"
    restarts. It is intentionally idempotent — running it twice when the server
    is already up just reports the running PID and exits.
    """
    args = sys.argv[2:]
    server_only = any(flag in args for flag in ("--server", "--no-frontend"))
    rebuild = "--rebuild" in args
    foreground = "--foreground" in args

    print("=== PIM up ===")
    api_key = _ensure_runtime_ready()

    if server_only:
        print("  Skipping frontend build (--server).")
    else:
        _ensure_frontend_built(rebuild=rebuild)

    if foreground:
        print("  Running in foreground (Ctrl+C to stop).")
        if api_key:
            print(f"  API Key: {_mask_secret(api_key)}")
        # service-run execs uvicorn in the current process — perfect for
        # `docker run` / `systemd Type=exec` style supervisors.
        cmd_service_run()
        return  # not reached; execve replaces the process

    # Short-circuit when the service is already healthy. Reinstalling the
    # plist (macOS) or respawning uvicorn (Linux) is not harmful, but it
    # briefly interrupts an otherwise happy server; idempotent re-runs of
    # `./pim up` should feel like a no-op.
    port = _get_pim_port()
    already_running_pid = _currently_running_pid()
    if already_running_pid and _is_livez_healthy():
        print(f"  Already running (PID {already_running_pid}); no restart needed.")
        if not server_only and (FRONTEND / "dist" / "index.html").exists():
            print(f"  Web UI: http://127.0.0.1:{port}/  (served by backend from frontend/dist)")
        if api_key:
            print(f"  API Key: {_mask_secret(api_key)}")
        return

    # Daemonize. On macOS the LaunchAgent provides auto-restart + login
    # persistence; on Linux/other we fall back to a detached uvicorn + PID
    # file, which survives the parent shell but won't come back after reboot.
    if sys.platform == "darwin":
        print("  Platform: macOS → using LaunchAgent (auto-restart + login start).")
        cmd_install_service()
    else:
        print("  Platform: non-macOS → using detached uvicorn + PID file.")
        pid = _launch_detached_backend()
        if pid is not None:
            print(f"  PID: {pid}")

    if _wait_for_livez():
        print(f"  Backend is healthy on http://127.0.0.1:{port}")
    else:
        print("  Warning: /livez did not return HTTP 200 yet; inspect ./pim logs")

    if not server_only and (FRONTEND / "dist" / "index.html").exists():
        print(f"  Web UI: http://127.0.0.1:{port}/  (served by backend from frontend/dist)")
    if api_key:
        print(f"  API Key: {_mask_secret(api_key)}")

    if sys.platform != "darwin":
        print("  Note: no process supervisor installed; after reboot rerun ./pim up.")


def _launch_detached_backend(port: int | None = None) -> int | None:
    """Spawn uvicorn as a detached background process and write the PID file.

    Returns the new PID, or None when the server was already running /
    another process holds the port. Callers are responsible for printing
    human-readable context around this low-level primitive.
    """
    target_port = port or _get_pim_port()
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    _rotate_log_file_if_needed()

    for pid_file in _pid_file_candidates():
        if pid_file.exists():
            existing_pid = _read_pid_file(pid_file)
            if existing_pid and _is_prod_uvicorn_pid(existing_pid, port=target_port):
                if pid_file != PID_FILE:
                    _write_pid_file(existing_pid)
                print(f"  Already running (PID {existing_pid})")
                return None
            pid_file.unlink(missing_ok=True)

    existing_pids = _find_prod_uvicorn_pids(port=target_port)
    if existing_pids:
        print(f"  Detected existing unmanaged server PID(s): {', '.join(str(p) for p in existing_pids)}")
        _write_pid_file(existing_pids[0])
        print(f"  Recovered PID file with PID {existing_pids[0]}")
        return existing_pids[0]

    if _is_port_open(target_port):
        print(f"  Port {target_port} is already in use by another process. Abort start.")
        return None

    log_handle = open(LOG_FILE, "a", encoding="utf-8")
    proc = subprocess.Popen(
        [
            _uvicorn(),
            "app.main:app",
            "--host", "127.0.0.1",
            "--port", str(target_port),
        ],
        cwd=str(BACKEND),
        env=_service_env(),
        stdout=log_handle,
        stderr=log_handle,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    log_handle.close()
    _write_pid_file(proc.pid)
    time.sleep(0.8)
    if proc.poll() is not None:
        print("  Failed to start. Last logs:")
        try:
            tail = subprocess.check_output(["tail", "-n", "30", str(LOG_FILE)], text=True)
            print(tail)
        except (OSError, subprocess.SubprocessError):
            pass
        _unlink_pid_files()
        sys.exit(1)
    return proc.pid


def _run_with_args(func, args: list[str]) -> None:
    original_argv = sys.argv
    sys.argv = [original_argv[0], original_argv[1], *args]
    try:
        func()
    finally:
        sys.argv = original_argv


def cmd_ensure():
    """Idempotently ensure the production backend is alive and HTTP-ready.

    Designed for no-systemd containers where a heartbeat/cron runner invokes
    this command repeatedly. It repairs stale PID files, restarts unhealthy PIM
    uvicorn processes, and refuses to take over the port when a foreign process is
    listening there.
    """
    args = sys.argv[2:]
    server_only = any(flag in args for flag in ("--server", "--no-frontend"))
    rebuild = "--rebuild" in args
    port = _get_pim_port()

    print("=== PIM ensure ===")
    api_key = _ensure_runtime_ready()
    if server_only:
        print("  Skipping frontend build (--server).")
    else:
        _ensure_frontend_built(rebuild=rebuild)

    running_pid = _currently_running_pid()
    if running_pid and _is_livez_healthy():
        print(f"  Healthy (PID {running_pid}); no action needed.")
        if api_key:
            print(f"  API Key: {_mask_secret(api_key)}")
        return

    if running_pid:
        print(f"  Existing PIM process is not healthy (PID {running_pid}); restarting.")
        _stop_by_pid()
    elif _is_port_open() or _is_port_8000_open():
        print(f"  Port {port} is already in use by another process. Abort ensure.", file=sys.stderr)
        sys.exit(1)

    if sys.platform == "darwin":
        print("  Platform: macOS → ensuring LaunchAgent.")
        cmd_install_service()
    else:
        print("  Platform: non-macOS → starting detached backend.")
        pid = _launch_detached_backend()
        if pid is not None:
            print(f"  PID: {pid}")

    if not _wait_for_livez():
        print("  Failed: /livez did not return HTTP 200; inspect ./pim logs", file=sys.stderr)
        sys.exit(1)

    print(f"  Backend is healthy on http://127.0.0.1:{port}")
    if api_key:
        print(f"  API Key: {_mask_secret(api_key)}")


def cmd_restart():
    """Stop then start the production backend."""
    args = sys.argv[2:]
    print("=== PIM restart ===")
    cmd_stop()
    _run_with_args(cmd_up, args)


def cmd_start():
    prod = "--prod" in sys.argv

    if not VENV.exists():
        print("venv not found. Run: ./pim setup")
        sys.exit(1)

    api_key = _read_api_key()
    port = _get_pim_port()

    if prod:
        print("Starting PIM (production mode) ...")
        print(f"  URL: http://127.0.0.1:{port}")
        if api_key:
            print(f"  API Key: {_mask_secret(api_key)}")

        pid = _launch_detached_backend(port=port)
        if pid is not None:
            print(f"  PID: {pid}")
            print("  Started in background.")
    else:
        dev_backend_port = 8000 if port == 3000 else port
        print("Starting PIM (dev mode) ...")
        print(f"  Backend: http://127.0.0.1:{dev_backend_port}")
        print("  Frontend: http://127.0.0.1:3000")
        if api_key:
            print(f"  API Key: {_mask_secret(api_key)}")

        env = _service_env()
        env["PIM_RUNTIME_PROFILE"] = "development"
        env["PIM_DEV_SERVER"] = "1"
        env["PIM_DEV_FRONTEND_URL"] = "http://127.0.0.1:3000"

        procs = []

        # Backend
        procs.append(subprocess.Popen(
            [_uvicorn(), "app.main:app", "--host", "127.0.0.1", "--port", str(dev_backend_port), "--reload"],
            cwd=str(BACKEND),
            env=env,
        ))

        # Frontend dev server
        if (FRONTEND / "package.json").exists():
            frontend_env = env.copy()
            # Keep browser requests same-origin through Vite's /api and
            # /bootstrap proxies. Direct cross-origin calls lose the local
            # browser-auth signal and make an otherwise healthy dev UI appear
            # unauthenticated.
            frontend_env.setdefault("PIM_DEV_HOST", "127.0.0.1")
            procs.append(subprocess.Popen(
                ["npm", "run", "dev"],
                cwd=str(FRONTEND),
                env=frontend_env,
            ))

        try:
            for p in procs:
                p.wait()
        except KeyboardInterrupt:
            for p in procs:
                p.terminate()
            print("\nStopped.")


def cmd_stop():
    # When the LaunchAgent is installed, unloading it both stops the process
    # and prevents launchd from restarting it.  A plain kill would just cause
    # launchd to respawn the server.
    if PLIST_PATH.exists():
        result = subprocess.run(["launchctl", "unload", str(PLIST_PATH)],
                                capture_output=True)
        if result.returncode == 0:
            print("PIM service stopped (LaunchAgent unloaded).")
            print("To start again: ./pim start --prod  or  ./pim install-service")
        else:
            print("launchctl unload failed; attempting direct kill as fallback.")
            _stop_by_pid()
        return

    _stop_by_pid()


def _stop_by_pid():
    stopped_any = False
    handled_pids: set[int] = set()

    for pid_file in _pid_file_candidates():
        if pid_file.exists():
            pid = _read_pid_file(pid_file)
            if pid:
                if _terminate_pid(pid):
                    print(f"Stopped PID {pid}")
                    stopped_any = True
                    handled_pids.add(pid)
                else:
                    print(f"Failed to stop PID {pid}")
            pid_file.unlink(missing_ok=True)

    extra_pids = [pid for pid in _find_prod_uvicorn_pids() if _is_pid_alive(pid)]
    for pid in extra_pids:
        if pid in handled_pids:
            continue
        if _terminate_pid(pid):
            print(f"Stopped unmanaged PID {pid}")
            stopped_any = True

    if not stopped_any:
        print("No running PIM server found.")


def cmd_status():
    port = _get_pim_port()
    # Check launchd-managed state first
    if PLIST_PATH.exists():
        result = subprocess.run(
            ["launchctl", "list", PLIST_NAME],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            # launchctl list <label> returns a plist-style dict.
            # Extract "PID" value if present (service is running).
            pid_match = None
            for line in result.stdout.splitlines():
                line = line.strip()
                if line.startswith('"PID"'):
                    # e.g.  "PID" = 12345;
                    pid_match = line.split("=", 1)[-1].strip().rstrip(";").strip()
                    break
            if pid_match and pid_match.isdigit():
                print(f"PIM is running via LaunchAgent (PID {pid_match})")
                print(f"  URL: http://127.0.0.1:{port}")
                print(f"  Logs: {LOG_FILE}")
                _print_atom_feature_status()
            else:
                print("PIM LaunchAgent is installed but the server is not running.")
                print("  Check logs: ./pim logs")
                _print_atom_feature_status()
            return
        print("PIM LaunchAgent is installed but not loaded.")
        _print_atom_feature_status()
        return

    # Fallback: PID file / process scan
    for pid_file in _pid_file_candidates():
        if pid_file.exists():
            pid = _read_pid_file(pid_file)
            if pid and _is_prod_uvicorn_pid(pid, port=port):
                if pid_file != PID_FILE:
                    _write_pid_file(pid)
                print(f"PIM is running (PID {pid})")
                _print_atom_feature_status()
                return
            pid_file.unlink(missing_ok=True)

    discovered = [pid for pid in _find_prod_uvicorn_pids(port=port) if _is_prod_uvicorn_pid(pid, port=port)]
    if discovered:
        pid = discovered[0]
        _write_pid_file(pid)
        print(f"PIM is running (PID {pid}, recovered PID file)")
        _print_atom_feature_status()
        return

    if _is_port_open(port):
        print(f"Port {port} is in use, but PIM process is not managed by current PID file.")
        _print_atom_feature_status()
        return
    print("PIM is not running.")
    _print_atom_feature_status()


def cmd_fetch():
    """Trigger a full fetch via API."""
    api_key = _read_api_key()
    port = _get_pim_port()
    import urllib.request
    import urllib.error

    url = f"http://127.0.0.1:{port}/api/sources/fetch-all"
    req = urllib.request.Request(url, method="POST")
    if api_key:
        req.add_header("X-API-Key", api_key)
    req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req) as resp:
            data = json.loads(resp.read())
            print(f"Fetch triggered: {data}")
    except urllib.error.URLError as e:
        print(f"Failed to connect to PIM server: {e}")
        print("Is the server running? Try: ./pim start --prod")


def cmd_logs():
