#!/usr/bin/env python3
"""PIM — Personal Info Monitor CLI.

Usage:
    ./pim up                One-shot: ensure deps + fresh frontend + daemonize.
                            On macOS uses LaunchAgent (survives reboot/logout);
                            elsewhere uses detached uvicorn with a PID file.
    ./pim up --server       Backend only (skip frontend build; for VPS).
    ./pim up --rebuild      Force rebuild of frontend/dist regardless of mtime.
    ./pim up --foreground   Run uvicorn in foreground (useful in containers).

    ./pim setup             First-time setup (venv, deps, runtime config, frontend build)
    ./pim install-service   Install macOS LaunchAgent (auto-starts on login, runs in background)
    ./pim uninstall-service Remove LaunchAgent and stop the service
    ./pim start             Start dev server (backend + frontend Vite :3000)
    ./pim start --prod      Start production server as background process (single :8000)
    ./pim stop              Stop the server (launchd-aware, falls back to pid scan)
    ./pim status            Show running status
    ./pim fetch             Trigger a full fetch now
    ./pim backup            Create a SQLite backup and archive local config
    ./pim rollback <rev>    Downgrade Alembic schema to a target revision
    ./pim logs              Tail the log file
    ./pim cleanup           Remove stale caches, rotated logs, and Python __pycache__
    ./pim bootstrap-url     Print a one-shot URL containing the bootstrap token
                            for auto-provisioning a fresh web browser session
"""

import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

ROOT = Path(__file__).resolve().parent
BACKEND = ROOT / "backend"
FRONTEND = ROOT / "frontend"
VENV = BACKEND / ".venv"
PID_FILE = Path.home() / ".pim" / "pim.pid"
LOG_FILE = Path.home() / ".pim" / "data" / "pim.log"
BACKUP_DIR = Path.home() / ".pim" / "backups"
ENV_FILE = BACKEND / ".env"
ENV_EXAMPLE_FILE = BACKEND / ".env.example"
PLIST_NAME = "com.pim.server"
PLIST_PATH = Path.home() / "Library" / "LaunchAgents" / f"{PLIST_NAME}.plist"


def _mask_secret(value: str, prefix: int = 4, suffix: int = 4) -> str:
    text = (value or "").strip()
    if not text:
        return "(not set)"
    if len(text) <= prefix + suffix:
        return "*" * len(text)
    return f"{text[:prefix]}...{text[-suffix:]}"


def _python():
    """Return venv python path."""
    return str(VENV / "bin" / "python")


def _pip():
    return str(VENV / "bin" / "pip")


def _uvicorn():
    return str(VENV / "bin" / "uvicorn")


def _alembic():
    return str(VENV / "bin" / "alembic")


def _ensure_venv():
    if not VENV.exists():
        print("Creating Python virtual environment ...")
        subprocess.check_call([sys.executable, "-m", "venv", str(VENV)])
    print(f"  venv: {VENV}")


def _install_deps():
    print("Installing Python dependencies ...")
    subprocess.check_call(
        [_pip(), "install", "-q", "-r", str(BACKEND / "requirements.txt")],
    )


def _install_playwright():
    print("Installing Playwright Chromium ...")
    subprocess.check_call(
        [_python(), "-m", "playwright", "install", "chromium"],
    )


def _ensure_env_file():
    """Create a local .env from the example when needed."""
    if ENV_FILE.exists():
        print(f"  .env already exists: {ENV_FILE}")
        return

    if ENV_EXAMPLE_FILE.exists():
        shutil.copyfile(ENV_EXAMPLE_FILE, ENV_FILE)
        print(f"  Created .env from template: {ENV_FILE}")
        return

    ENV_FILE.write_text(
        "DATA_DIR=~/.pim/data\n"
        "FETCH_CONCURRENCY=20\n"
        # Master LLM kill switch + per-feature ENRICH_* toggles. Default to
        # "ingest-only" until the user configures API keys; once configured, set
        # AI_PROCESSING_ENABLED=true and flip individual ENRICH_* gates on.
        "AI_PROCESSING_ENABLED=false\n"
        "ENRICH_SUMMARY_ENABLED=false\n"
        "ENRICH_TRANSLATE_ENABLED=false\n"
    )
    print(f"  Created minimal .env: {ENV_FILE}")


def _bootstrap_runtime_api_key() -> Optional[str]:
    """Initialize runtime secrets and return the active API key."""
    if not VENV.exists():
        return None

    try:
        output = subprocess.check_output(
            [
                _python(),
                "-c",
                (
                    "from app.config import bootstrap_runtime_environment, get_settings; "
                    "bootstrap_runtime_environment(); "
                    "print(get_settings().pim_api_key, end='')"
                ),
            ],
            cwd=str(BACKEND),
            text=True,
        )
    except Exception:
        return None

    return output.strip() or None


def _bootstrap_token() -> Optional[str]:
    """Return the bootstrap token guarding /local-token (initializes on first call)."""
    if not VENV.exists():
        return None

    try:
        output = subprocess.check_output(
            [
                _python(),
                "-c",
                (
                    "from app.config import bootstrap_runtime_environment, get_settings; "
                    "bootstrap_runtime_environment(); "
                    "print(get_settings().bootstrap_token, end='')"
                ),
            ],
            cwd=str(BACKEND),
            text=True,
