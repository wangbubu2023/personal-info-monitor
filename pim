def _mask_secret(value: str, prefix: int = 4, suffix: int = 4) -> str:
    text = (value or "").strip()
    if not text:
        return "(not set)"
    if len(text) <= prefix + suffix:
        return "*" * len(text)
    return f"{text[:prefix]}...{text[-suffix:]}"


