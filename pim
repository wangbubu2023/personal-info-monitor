        os.execvp("tail", ["tail", "-f", str(LOG_FILE)])
    else:
        print(f"Log file not found: {LOG_FILE}")
        print("Logs appear in the terminal when running in foreground.")


def cmd_cleanup():
    """Remove Celery remnants, rotated local backend logs, and Python __pycache__ dirs."""
    log_dir = ROOT / ".pim-local-logs"
    pid_dir = ROOT / ".pim-local-pids"
    removed = 0

    if log_dir.is_dir():
        for pattern in ("celery_*", "celery-*"):
            for path in log_dir.glob(pattern):
                try:
                    path.unlink()
                    removed += 1
                    print(f"  removed {path.relative_to(ROOT)}")
                except OSError as e:
                    print(f"  skip {path}: {e}")
        for path in log_dir.glob("backend.log.*"):
            try:
                path.unlink()
                removed += 1
                print(f"  removed {path.relative_to(ROOT)}")
            except OSError as e:
                print(f"  skip {path}: {e}")

    if pid_dir.is_dir():
        for path in pid_dir.glob("celery_*"):
            try:
                path.unlink()
                removed += 1
                print(f"  removed {path.relative_to(ROOT)}")
            except OSError as e:
                print(f"  skip {path}: {e}")

    for cache in ROOT.rglob("__pycache__"):
        if cache.is_dir():
            try:
                shutil.rmtree(cache)
                removed += 1
                print(f"  removed {cache.relative_to(ROOT)}")
            except OSError as e:
                print(f"  skip {cache}: {e}")

    print(f"Cleanup done ({removed} item(s)).")


def cmd_backup():
    """Create a hot SQLite backup plus a small config archive."""
    if not VENV.exists():
        print("venv not found. Run: ./pim setup")
        sys.exit(1)

    runtime = _read_runtime_metadata()
    db_path = _sqlite_path_from_url(str(runtime.get("database_url") or ""))
    if not db_path or not db_path.exists():
        print("SQLite database not found. Start the app once or check DATA_DIR.")
        sys.exit(1)

    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    db_backup_path = BACKUP_DIR / f"pim-{stamp}.sqlite3"
    config_archive_path = BACKUP_DIR / f"pim-{stamp}-config.tar.gz"
    runtime_secrets = Path(str(runtime.get("data_dir") or "")).expanduser() / "runtime-secrets.json"

    subprocess.check_call(
        [
            _python(),
            "-c",
            (
                "import sqlite3, sys; "
                "src, dst = sys.argv[1], sys.argv[2]; "
                "source = sqlite3.connect(src); "
                "target = sqlite3.connect(dst); "
                "source.backup(target); "
                "target.close(); "
                "source.close()"
            ),
            str(db_path),
            str(db_backup_path),
        ],
        cwd=str(BACKEND),
    )

    archive_inputs = [path for path in [ENV_FILE, runtime_secrets] if path.exists()]
    if archive_inputs:
        subprocess.check_call(
            ["tar", "-czf", str(config_archive_path), *[str(path) for path in archive_inputs]],
            cwd=str(ROOT),
        )
    print(f"Database backup: {db_backup_path}")
    if archive_inputs:
        print(f"Config archive:   {config_archive_path}")


def cmd_rollback():
    """Downgrade Alembic schema to the requested revision."""
    if not VENV.exists():
        print("venv not found. Run: ./pim setup")
        sys.exit(1)

    if len(sys.argv) < 3:
        print("Usage: ./pim rollback <revision>")
        sys.exit(2)

    revision = sys.argv[2].strip()
    if not revision:
        print("Revision must not be empty.")
        sys.exit(2)

    subprocess.check_call([_alembic(), "downgrade", revision], cwd=str(BACKEND))
    print(f"Alembic downgraded to {revision}")


def cmd_service_run():
    """[Internal] Run uvicorn in the foreground — called by the LaunchAgent plist.

    Loads .env, sets up the venv environment, then exec()s uvicorn so that
    launchd tracks the actual server process (not a Python wrapper).
    """
    if not VENV.exists():
        print("venv not found. Run: ./pim setup", file=sys.stderr)
        sys.exit(1)

    env = os.environ.copy()
    env["VIRTUAL_ENV"] = str(VENV)
    env["PATH"] = str(VENV / "bin") + ":" + env.get("PATH", "")
    env.setdefault("HOME", str(Path.home()))
    env.setdefault("LANG", "en_US.UTF-8")

    # Load .env into the environment (values already in env take priority)
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k = k.strip()
            v = v.strip().strip('"').strip("'")
            # Skip empty values — they must not shadow runtime-secrets.json
            # (e.g. PIM_API_KEY= in .env would block bootstrap from setting the real key)
            if k and v:
                env.setdefault(k, v)

    port = _get_pim_port()
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    os.chdir(str(BACKEND))
    uvicorn_bin = str(_uvicorn())
    # exec() replaces this process — launchd tracks uvicorn's PID directly
    os.execve(uvicorn_bin, [
        uvicorn_bin,
        "app.main:app",
        "--host", "127.0.0.1",
        "--port", str(port),
    ], env)


def cmd_install_service():
    """Install (or reinstall) a macOS LaunchAgent that keeps PIM running in the background.

    After installation PIM starts immediately and auto-restarts on login.
    Use './pim uninstall-service' to remove it.
    """
    if not VENV.exists():
        print("venv not found. Run: ./pim setup first.")
        sys.exit(1)

    PLIST_PATH.parent.mkdir(parents=True, exist_ok=True)
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    launchctl_domain = f"gui/{os.getuid()}"
    launchctl_target = f"{launchctl_domain}/{PLIST_NAME}"

    plist_content = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{PLIST_NAME}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{VENV / "bin" / "python3"}</string>
        <string>{ROOT / "pim"}</string>
        <string>service-run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>{ROOT}</string>
    <key>StandardOutPath</key>
    <string>{LOG_FILE}</string>
    <key>StandardErrorPath</key>
    <string>{LOG_FILE}</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
"""
    PLIST_PATH.write_text(plist_content, encoding="utf-8")

    try:
        install_launch_agent(
            launchctl_domain=launchctl_domain,
            launchctl_target=launchctl_target,
            plist_path=PLIST_PATH,
            run=subprocess.run,
            wait_for_unloaded=wait_for_launchctl_unloaded,
        )
    except LaunchAgentError as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)

    print(f"LaunchAgent installed: {PLIST_PATH}")
    print("PIM is now running in the background and will auto-start on login.")
    print(f"Logs: {LOG_FILE}\nTo stop: ./pim uninstall-service")


def cmd_uninstall_service():
    """Remove the LaunchAgent and stop the service."""
    if not PLIST_PATH.exists():
        print("LaunchAgent not installed.")
        return
    subprocess.run(["launchctl", "unload", str(PLIST_PATH)],
                   capture_output=True)
    PLIST_PATH.unlink()
    print("LaunchAgent removed. PIM will no longer auto-start on login.")
    print("Any currently running instance has been stopped.")


def cmd_bootstrap_url():
    """Print a single-use, five-minute Web binding URL."""
    args = sys.argv[2:]
    configured_public_url = (
        _read_env_var("PIM_PUBLIC_URL")
        or _read_env_var("PIM_PUBLIC_ORIGIN")
    )
    try:
        host, explicit_origin = resolve_bootstrap_host(
            args,
            configured_public_url=configured_public_url,
        )
    except BootstrapUrlError as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(2)

    if not VENV.exists():
        print("PIM environment unavailable. Run: ./pim setup", file=sys.stderr)
        sys.exit(1)

    try:
        raw_output = subprocess.check_output(
            [
                _python(),
                "-c",
                (
                    "from app.config import bootstrap_runtime_environment; "
                    "bootstrap_runtime_environment(); "
                    "from app.migrations import run_migrations; run_migrations(); "
                    "from app.platform.auth.web_session import issue_bootstrap_code; "
                    "print(issue_bootstrap_code(), end='')"
                ),
            ],
            cwd=str(BACKEND),
            text=True,
        )
        # Alembic may emit migration log lines to stdout before the bootstrap
        # code. The issuer always prints the single-use code last, so keep only
        # the final non-empty line instead of accidentally embedding logs in
        # the URL fragment.
        code = next(
            (line.strip() for line in reversed(raw_output.splitlines()) if line.strip()),
            "",
        )
        if not code:
            raise subprocess.SubprocessError("bootstrap issuer returned no code")
    except (OSError, subprocess.SubprocessError):
        print("Could not issue bootstrap code. Check backend configuration.", file=sys.stderr)
        sys.exit(1)

    bootstrap_url = build_bootstrap_url(host, code)
    print(bootstrap_url)
    print("Open this URL directly; no code entry is required.", file=sys.stderr)
    print(
        "The link expires in 5 minutes, works once, and its fragment is removed "
        "from browser history before exchange.",
        file=sys.stderr,
    )
    if explicit_origin and not configured_public_url:
        print(
            "Ensure the running server also has this address in PIM_PUBLIC_URL "
            "(or CORS_ORIGINS) and was restarted.",
            file=sys.stderr,
        )


def _run_auth_bundle_cli(*prefix_args: str):
    if not VENV.exists():
        print("venv not found. Run: ./pim setup", file=sys.stderr)
        sys.exit(1)
    cmd = [_python(), str(ROOT / "pimctl"), "auth-bundle", *prefix_args, *sys.argv[2:]]
    raise SystemExit(subprocess.call(cmd, cwd=str(ROOT)))


def cmd_auth_bundle():
    _run_auth_bundle_cli()


def cmd_capture_session():
    _run_auth_bundle_cli("export")


def cmd_support_bundle():
    """Create a redacted support bundle zip."""
    if not VENV.exists():
        print("venv not found. Run: ./pim setup", file=sys.stderr)
        sys.exit(1)

    args = sys.argv[2:]
    output_path = None
    if "--out" in args:
        idx = args.index("--out")
        if idx + 1 >= len(args) or not args[idx + 1].strip():
            print("Usage: ./pim support-bundle [--out /path/to/bundle.zip]", file=sys.stderr)
            sys.exit(2)
        output_path = args[idx + 1]

    script = r"""
from pathlib import Path
import sys

from app.config import bootstrap_runtime_environment
from app.database import SessionLocal
from app.domains.system.support_bundle import SupportBundleService

bootstrap_runtime_environment()
out = Path(sys.argv[1]).expanduser() if len(sys.argv) > 1 and sys.argv[1] else None
db = SessionLocal()
try:
    path = SupportBundleService(db).build_bundle(out)
finally:
    db.close()
print(path)
"""
    cmd = [_python(), "-c", script]
    if output_path:
        cmd.append(output_path)
    proc = subprocess.run(cmd, cwd=str(BACKEND), text=True)
    raise SystemExit(proc.returncode)


