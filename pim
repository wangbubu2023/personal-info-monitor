#!/usr/bin/env python3
"""PIM — Personal Info Monitor CLI.

Usage:
    ./pim up                One-shot: ensure deps + fresh frontend + daemonize.
                            On macOS uses LaunchAgent (survives reboot/logout);
                            elsewhere uses detached uvicorn with a PID file.
    ./pim up --server       Backend only (skip frontend build; for VPS).
    ./pim up --rebuild      Force rebuild of frontend/dist regardless of mtime.
    ./pim up --foreground   Run uvicorn in foreground (useful in containers).

    ./pim setup             First-time setup (venv, deps, browser runtime, runtime config, frontend build)
                            Use --skip-playwright to skip browser bootstrap.
                            Use --skip-playwright-deps to skip Linux system package install.
    ./pim upgrade           Backup, fast-forward git pull, refresh deps/frontend, restart if local service is running
                            Use --server for backend-only VPS, --systemd <unit> for systemd, --no-pull for tag/detached deploys.
                            Use --restart-mode ensure for no-systemd containers.
    ./pim install-service   Install macOS LaunchAgent (auto-starts on login, runs in background)
    ./pim uninstall-service Remove LaunchAgent and stop the service
    ./pim start             Start dev server (backend + frontend Vite :3000)
    ./pim dev               Alias for local development profile with inline annotations
    ./pim start --prod      Start production server as background process (single :8000)
    ./pim ensure            Idempotently ensure the production server is healthy; start/restart if needed
    ./pim restart           Stop then start the production server
    ./pim stop              Stop the server (launchd-aware, falls back to pid scan)
    ./pim status            Show running status and atom feature flags
    ./pim fetch             Trigger a full fetch now
    ./pim backup            Create a SQLite backup and archive local config
    ./pim rollback <rev>    Downgrade Alembic schema to a target revision
    ./pim logs              Tail the log file
    ./pim support-bundle    Export a redacted diagnostic zip for bug reports
                            Use --out <path> to choose the output file.
    ./pim cleanup           Remove stale caches, rotated logs, and Python __pycache__
    ./pim bootstrap-url     Print a one-click, single-use Web binding URL
                            Configure PIM_PUBLIC_URL for VPS/public access.
    ./pim auth-bundle       Export/import local browser login bundles
                            Example: ./pim auth-bundle export https://example.com --out example.pim-auth-bundle.json
    ./pim login-sync        Guided local browser login-state sync to a VPS
    ./pim capture-session   Alias for: ./pim auth-bundle export <site_url> [...]
"""

