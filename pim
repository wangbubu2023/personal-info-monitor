def _install_playwright_system_deps(module: str, args: set[str]) -> None:
    if "--skip-playwright-deps" in args or _parse_env_bool(os.environ.get("PIM_SKIP_PLAYWRIGHT_DEPS")):
        print("Skipping Playwright Linux system dependency install.")
        return
    if not sys.platform.startswith("linux"):
        print("  Browser system dependencies: not Linux, skipping package install.")
        return

    apt = shutil.which("apt-get") or shutil.which("apt")
    dnf = shutil.which("dnf")
    yum = shutil.which("yum")
    zypper = shutil.which("zypper")

    if apt:
        base_cmd = [_python(), "-m", module, "install-deps", "chromium"]
    elif dnf:
        base_cmd = [dnf, "install", "-y", *_PLAYWRIGHT_RHEL_PACKAGES]
    elif yum:
        base_cmd = [yum, "install", "-y", *_PLAYWRIGHT_RHEL_PACKAGES]
    elif zypper:
        base_cmd = [zypper, "--non-interactive", "install", *_PLAYWRIGHT_ZYPPER_PACKAGES]
    else:
        print("  Warning: no supported Linux package manager found for Chromium system deps.")
        print("  Supported package managers: apt, dnf, yum, zypper.")
        print("  The Playwright smoke test will verify whether dependencies are already present.")
        return

    cmd = _privileged_command(base_cmd)
    if cmd is None:
        print("  Warning: sudo is not available; cannot install Chromium system packages automatically.")
        _print_manual_command(["sudo", *base_cmd])
        print("  The Playwright smoke test will verify whether dependencies are already present.")
        return

    print("Installing Playwright Chromium system dependencies ...")
    subprocess.check_call(cmd, cwd=str(BACKEND))


def _smoke_test_playwright() -> None:
    print("Verifying Playwright Chromium launch ...")
    script = r"""
import asyncio

from app.platform.browser.playwright_runtime import (
    async_playwright,
    backend_name,
    default_channel,
    recommended_launch_args,
)


async def main():
    channel = default_channel()
    launch_kwargs = {"headless": True, "args": recommended_launch_args([])}
    if channel:
        launch_kwargs["channel"] = channel
    async with async_playwright() as p:
        browser = await p.chromium.launch(**launch_kwargs)
        try:
            page = await browser.new_page()
            await page.goto("about:blank")
        finally:
            await browser.close()
    print(
        "  Playwright smoke OK "
        f"(backend={backend_name()}, channel={channel or 'bundled'}, args={launch_kwargs['args']})"
    )


asyncio.run(main())
"""
    env = os.environ.copy()
    env.setdefault("PYTHONPATH", str(BACKEND))
    try:
        subprocess.check_call(
            [_python(), "-c", script],
            cwd=str(BACKEND),
            env=env,
        )
    except subprocess.CalledProcessError as exc:
        print("", file=sys.stderr)
        print("Playwright Chromium smoke test failed.", file=sys.stderr)
        print("Fix the browser runtime before starting PIM:", file=sys.stderr)
        print("  ./pim setup", file=sys.stderr)
        print("On RHEL-family hosts, install the Chromium system packages shown in docs/VPS_DEPLOY.md.", file=sys.stderr)
        print("In containers/root-run services, keep PIM_PLAYWRIGHT_NO_SANDBOX=auto or set it to always.", file=sys.stderr)
        print("If you set PIM_PLAYWRIGHT_CHANNEL=chrome, install Google Chrome or unset the variable.", file=sys.stderr)
        sys.exit(exc.returncode or 1)


