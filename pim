def _privileged_command(cmd: list[str]) -> list[str] | None:
    geteuid = getattr(os, "geteuid", None)
    if not callable(geteuid) or geteuid() == 0:
        return cmd
    sudo = shutil.which("sudo")
    if not sudo:
        return None
    return [sudo, *cmd]


def _print_manual_command(cmd: list[str]) -> None:
    print("  Run manually:")
    print("    " + " ".join(cmd))


