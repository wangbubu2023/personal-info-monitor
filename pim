# Files/dirs whose mtime rules whether `frontend/dist` is considered out of date.
# Node modules and the dist itself are intentionally excluded: the former is
# managed by `npm ci`, the latter is the build output we're comparing against.
_FRONTEND_STALE_INPUTS = (
    "src",
    "public",
    "index.html",
    "package.json",
    "package-lock.json",
    "vite.config.ts",
    "vite.config.js",
    "tsconfig.json",
    "tsconfig.app.json",
    "tailwind.config.js",
    "postcss.config.js",
)


def _latest_mtime(root: Path) -> float:
    """Return the newest mtime under *root* (inclusive). 0 if nothing exists."""
    if not root.exists():
        return 0.0
    if root.is_file():
        return root.stat().st_mtime
    latest = root.stat().st_mtime
    for entry in root.rglob("*"):
        try:
            if entry.is_file():
                latest = max(latest, entry.stat().st_mtime)
        except OSError:
            continue
    return latest


def _frontend_dist_stale() -> tuple[bool, str]:
    """Return (is_stale, reason). Reason is a human-readable hint for logs."""
    dist_html = FRONTEND / "dist" / "index.html"
    if not dist_html.exists():
        return True, "dist/index.html missing"

    dist_mtime = dist_html.stat().st_mtime
    for rel in _FRONTEND_STALE_INPUTS:
        source_mtime = _latest_mtime(FRONTEND / rel)
        if source_mtime > dist_mtime:
            return True, f"{rel} is newer than dist"
    return False, "dist is up to date"


def _ensure_frontend_built(rebuild: bool) -> bool:
    """Rebuild frontend/dist when missing or stale. Returns True if work was done.

    Skips gracefully when `frontend/package.json` or `npm` is unavailable —
    that's the "this is a server, no UI needed" case.
    """
    if not (FRONTEND / "package.json").exists():
        print("  Frontend sources not found; skipping build.")
        return False
    if shutil.which("npm") is None:
        print("  npm not found on PATH; skipping frontend build.")
        return False

    if rebuild:
        stale, reason = True, "forced rebuild"
    else:
        stale, reason = _frontend_dist_stale()

    if not stale:
        print(f"  Frontend dist/ is fresh ({reason}).")
        return False

    print(f"  Frontend needs rebuild: {reason}")
    if not (FRONTEND / "node_modules").exists():
        print("  Installing frontend dependencies (first run) ...")
        subprocess.check_call(["npm", "ci"], cwd=str(FRONTEND))
    print("  Building frontend ...")
    subprocess.check_call(["npm", "run", "build"], cwd=str(FRONTEND))
    return True


def _service_env() -> dict:
    """Environment vars shared by every backend launch path."""
    env = os.environ.copy()
    env["VIRTUAL_ENV"] = str(VENV)
    env["PATH"] = str(VENV / "bin") + ":" + env.get("PATH", "")
    env.setdefault("HOME", str(Path.home()))
    env.setdefault("LANG", "en_US.UTF-8")

    # Load backend/.env (values already in env take priority).
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k = k.strip()
            v = v.strip().strip('"').strip("'")
            if k and v:
                env.setdefault(k, v)

    return env


def _get_pim_port() -> int:
    """Resolve configured PIM service port (priority: PIM_PORT -> PORT -> .env -> 8000)."""
    raw = os.environ.get("PIM_PORT") or os.environ.get("PORT")
    if not raw and ENV_FILE.exists():
        try:
            for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                k = k.strip()
                v = v.strip().strip('"').strip("'")
                if k in ("PIM_PORT", "PORT") and v:
                    raw = v
                    break
        except OSError:
            pass
    if raw:
        try:
            return int(raw)
        except ValueError:
            pass
    return 8000


def _wait_for_port(port: int | None = None, timeout_seconds: float = 12.0) -> bool:
    target_port = port if port is not None else _get_pim_port()
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        if _is_port_open(target_port):
            return True
        time.sleep(0.3)
    return False


def _wait_for_port_8000(timeout_seconds: float = 12.0) -> bool:
    return _wait_for_port(port=8000, timeout_seconds=timeout_seconds)


def _is_livez_healthy(port: int | None = None) -> bool:
    import urllib.error
    import urllib.request

    target_port = port if port is not None else _get_pim_port()
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{target_port}/livez", timeout=1.0) as resp:
            return resp.status == 200
    except (OSError, urllib.error.URLError):
        return False


def _wait_for_livez(port: int | None = None, timeout_seconds: float = 15.0) -> bool:
    target_port = port if port is not None else _get_pim_port()
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        if _is_livez_healthy(target_port):
            return True
        time.sleep(0.3)
    return False


def _rotate_log_file_if_needed() -> None:
    max_bytes = _parse_env_int(
        os.environ.get("PIM_LOG_ROTATE_BYTES"),
        default=DEFAULT_LOG_ROTATE_BYTES,
    )
    if max_bytes <= 0 or not LOG_FILE.exists():
        return
    try:
        if LOG_FILE.stat().st_size < max_bytes:
            return
        rotated = LOG_FILE.with_name(f"{LOG_FILE.name}.1")
        rotated.unlink(missing_ok=True)
        LOG_FILE.replace(rotated)
        print(f"  Rotated log: {rotated}")
    except OSError as exc:
        print(f"  Warning: failed to rotate log {LOG_FILE}: {exc}", file=sys.stderr)


