# ============================================================
# Personal Information Monitor — 环境配置模板
# 运行 ./pim setup 会生成本地 .env 模板。
# 默认安全密钥保存在 DATA_DIR/runtime-secrets.json，可按需在此覆盖。
# 如需自定义，复制此文件为 .env 后修改。
# ============================================================

# PIM API Key（访问 API 的认证密钥；默认由 runtime-secrets.json 管理）
PIM_API_KEY=

# Bootstrap Token（守护 /local-token 端点，默认由 runtime-secrets.json 管理，
# 通过 0600 权限文件分发给 Tauri 壳；纯 Web 模式可通过 `./pim bootstrap-url` 获取一次性带 token 链接）
BOOTSTRAP_TOKEN=

# 数据目录（SQLite 数据库和日志存放路径）
DATA_DIR=~/.pim/data

# 公网部署时用于 ./pim bootstrap-url 生成浏览器引导链接，例如 https://pim.example.com
PIM_PUBLIC_URL=

# 请求的抓取并发数。默认保持历史基线的 20 路活动抓取。
FETCH_CONCURRENCY=20
# 紧急降载上限；默认不压低 20 路吞吐。资源受限主机或故障排查时可临时设为 4/8，
# 无需修改既有 FETCH_CONCURRENCY 配置。允许范围 1-64。
FETCH_ACTIVE_LIMIT=20
# 业务日期时区（影响 dashboard / digest / hourly / email / AI budget 默认日期）
USER_TIMEZONE=Asia/Shanghai
# APScheduler 时区（兼容旧配置；默认应与 USER_TIMEZONE 保持一致）
SCHEDULER_TIMEZONE=Asia/Shanghai
# 事件循环阻塞观测：超过阈值会记录 asyncio slow callback / loop lag（0=关闭）
EVENT_LOOP_SLOW_CALLBACK_SECONDS=0.1
EVENT_LOOP_LAG_PROBE_INTERVAL_SECONDS=1.0
# Durable Job 租约、心跳、stage timeout 与优雅关闭
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
FETCH_STAGE_TIMEOUT_SECONDS=900
POSTPROCESS_STAGE_TIMEOUT_SECONDS=600
SHUTDOWN_GRACE_SECONDS=30
# verbose diagnostics 使用有界轮转 JSONL，不进入核心 SQLite 事务
DIAGNOSTIC_BUFFER_MAX=2000
DIAGNOSTIC_BATCH_SIZE=100
DIAGNOSTIC_ROTATE_BYTES=10485760
DIAGNOSTIC_DISK_LIMIT_BYTES=104857600

# GitHub Release 版本检测（可选）。共享出口 IP 容易触发匿名 API 的 60 次/小时限制，
# 可配置最小权限 token，将认证请求额度提升到 GitHub 账户级配额。
PIM_UPDATE_CHECK_GITHUB_TOKEN=

# Web 端“升级 PIM”按钮的附加参数（可选）。固定在 tag/commit、或由外部守护
# 进程管理时，建议使用：--no-pull --no-restart；这样只刷新当前 checkout 的依赖和
# 前端产物，版本切换与重启交给 SSH/发布流程和外部守护进程。未设置时，detached HEAD
# 会自动加 --no-pull，普通分支仍会执行 git pull。
PIM_UI_UPGRADE_ARGS=

# 部署级 AI 紧急停机开关（阻止所有新的 outbound LLM 调用）
PIM_AI_HARD_DISABLE=false
# 粗略的每日 token 上限（0=不限制；按 prompt 长度 + max_tokens 估算，防意外高额账单）
AI_DAILY_TOKEN_BUDGET=0
# 粗略的每月 token 上限（0=不限制；与每日上限共用 SQLite 持久计数）
AI_MONTHLY_TOKEN_BUDGET=0

# ============================================================
# 以下五项仅供 v2.0 前已有安装执行一次性升级迁移；迁移结果和版本会写入
# system_settings / ai_policy_migration_state，此后修改或删除 env 均不会改变产品开关。
# 新安装请在「设置 → AI 模型」控制自动摘要、列表翻译、主观评分与全局暂停。
# 移除目标：v2.0。
# ============================================================
# AI_PROCESSING_ENABLED=false
# 旧版：是否自动摘要
# ENRICH_AUTO_ON_INGEST=false
# 旧版：是否允许 LLM 摘要
# ENRICH_SUMMARY_ENABLED=false
# 旧版：是否允许 LLM 翻译
# ENRICH_TRANSLATE_ENABLED=false
# 旧版：是否启用主观评分 Shadow
# PIM_SCORE_LLM_SUBJECTIVE=false
# 连续抓取失败达到该次数后自动停用信源（0=不自动停用）
FETCH_ERROR_DISABLE_THRESHOLD=12

# 加密密钥（用于加密存储的凭据；默认由 runtime-secrets.json 管理）
ENCRYPTION_KEY=

# JWT 密钥（默认由 runtime-secrets.json 管理）
JWT_SECRET_KEY=

# X (Twitter) — 默认走浏览器 Cookie/GraphQL。官方 API 属付费/配额 fallback，
# 仅在信源 metadata.strategy=api 或 allow_x_api_fallback=true 时使用。
X_AUTH_TOKEN=
X_CT0_TOKEN=
X_BEARER_TOKEN=
RSSHUB_URL=https://rsshub.app
NITTER_INSTANCES=

# YouTube API
YOUTUBE_API_KEY=

# Email SMTP（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 反向代理（可选，VPS 部署时配置）
# 填写反向代理（nginx/Caddy）的 IP，逗号分隔；设置后从 X-Real-IP 读取真实客户端 IP
# 用于修正 /local-token 的 loopback 检查和 per-IP 速率限制
TRUSTED_PROXY_IPS=

# 每分钟每客户端最大请求数（0 = 关闭限速）
API_RATE_LIMIT_PER_MINUTE=120
# /local-token 每分钟每 IP 上限（0 = 关闭；防 bootstrap_token 暴力尝试）
LOCAL_TOKEN_RATE_LIMIT_PER_MINUTE=30

# 开发用：设为 true 时跳过 Alembic 迁移（勿在生产开启）
# PIM_SKIP_MIGRATIONS=true

# 小时简报：默认跳过 Markdown 格式校验，直接保存模型原文（用完请设 false）
# PIM_HOURLY_DIGEST_SKIP_FORMAT_VALIDATION=false

# Feature flags（运行期开关）
# PIM_FEATURE_PLAYWRIGHT=true   # 关闭后所有 Playwright 路径（动态网页抓取、Cookie 登录态引导）都会降级为空操作
# PIM_FEATURE_X_PLAYWRIGHT=false # 关闭 X (Twitter) 登录态 Chromium 抓取；默认关闭（ADR-003 合规原因）
# PIM_BROWSER_BACKEND=patchright # patchright 可用时默认使用；设为 playwright 可强制使用官方 Playwright
# PIM_PLAYWRIGHT_CHANNEL=none    # 默认 bundled Chromium；设为 chrome 表示使用系统 Google Chrome（需自行安装）
# PIM_PLAYWRIGHT_NO_SANDBOX=auto # auto|always|never；Linux 容器/root 服务默认自动加 --no-sandbox
# PIM_SKIP_PLAYWRIGHT_DEPS=false # ./pim setup 时是否跳过 Linux Chromium 系统依赖安装
# PIM_DISABLE_PASSWORD_AUTO_LOGIN=false # VPS/headless 推荐设 true，仅复用导入的 cookie/browser-session，不自动跑密码登录

# 日志轮转（PIM_LOG_DIR 为空则不落盘）
# PIM_LOG_DIR=.pim-local-logs
# PIM_LOG_MAX_BYTES=10485760    # 单文件上限（字节），默认 10MB，最小 64KB
# PIM_LOG_BACKUP_COUNT=5        # 保留的轮转文件数量，默认 5，最大 100

# Debug 模式
DEBUG=false

# ============================================================
# 新闻原子库（main 分支暂时冻结；dev 分支可继续探索；数据存于 DATA_DIR/pim.db）
# ============================================================
ATOMS_ENABLED=false
ATOMS_RELATIONS_ENABLED=false
# Event v1 writes default to Shadow; the production Today read switch remains
# fail-closed until formal Eval + 7-day shadow gates are approved.
EVENT_V1_ENABLED=true
EVENT_V1_ASSIGNMENT=true
EVENT_V1_TODAY_READ=false
EVENT_V1_READ_GATE_APPROVED=false
EVENT_ASSIGNMENT_MODE=rules
EVENT_REBALANCE_ENABLED=true
EVENT_AUTO_MERGE_ENABLED=false
EVENT_AUTO_SPLIT_ENABLED=false
EVENT_LLM_JUDGE_ENABLED=false
EVENT_SIGNATURE_LLM_ENABLED=false
EVENT_CROSSLINGUAL_ENABLED=false
EVENT_STORYLINE_ENABLED=false
EVENT_DEBUG_EXPLAIN_ENABLED=false
EVENT_ASSIGNMENT_LOG_RETENTION_DAYS=30
