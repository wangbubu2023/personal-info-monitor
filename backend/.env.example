# ============================================================
# Personal Information Monitor — 环境配置模板
# 运行 ./pim setup 会生成本地 .env 模板。
# 默认安全密钥保存在 DATA_DIR/runtime-secrets.json，可按需在此覆盖。
# 如需自定义，复制此文件为 .env 后修改。
# ============================================================

# PIM API Key（访问 API 的认证密钥；默认由 runtime-secrets.json 管理）
PIM_API_KEY=

# 数据目录（SQLite 数据库和日志存放路径）
DATA_DIR=~/.pim/data

# 抓取并发数
FETCH_CONCURRENCY=20

# AI 处理（翻译、摘要，默认关闭）
AI_PROCESSING_ENABLED=false

# 加密密钥（用于加密存储的凭据；默认由 runtime-secrets.json 管理）
ENCRYPTION_KEY=

# JWT 密钥（默认由 runtime-secrets.json 管理）
JWT_SECRET_KEY=

# X (Twitter) — GraphQL API（免费，需浏览器 Cookie）
X_AUTH_TOKEN=
X_CT0_TOKEN=

# YouTube API
YOUTUBE_API_KEY=

# Email SMTP（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Debug 模式
DEBUG=false
