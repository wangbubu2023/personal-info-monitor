{
  "name": "pim-auth-assistant",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "check:pinned-deps": "node -e \"const p=require('./package.json'); const deps={...p.dependencies,...p.devDependencies}; const bad=Object.entries(deps).filter(([,v])=>v==='latest'||/^[\\^~*]/.test(v)||/^[<>]=?/.test(v)); if(bad.length){ console.error('Unpinned dependencies: '+bad.map(([k,v])=>k+'@'+v).join(', ')); process.exit(1); }\"",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.1.4",
    "typescript": "7.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "antd": "6.5.0",
    "@ant-design/icons": "6.3.2",
    "@tanstack/react-query": "5.101.2",
    "axios": "1.18.1",
    "jszip": "3.10.1",
    "lucide-react": "1.23.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@tauri-apps/api": "2.11.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
