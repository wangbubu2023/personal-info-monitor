{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PIM Auth Assistant",
  "version": "0.1.0",
  "identifier": "app.personalinfomonitor.auth-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "PIM Auth Assistant",
        "width": 1180,
        "height": 820,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {}
}
